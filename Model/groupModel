const moongoose = require("mongoose");

const groupSchema = new moongoose.Schema({
  image: {
    type: String,
  },
  groupName: {
    type: String,
  },
  groupDescription: {
    type: String,
  },
  city: {
    type: String,
  },
  serviceArea: {
    type: String,
  },
});

module.exports = moongoose.model("Group", groupSchema);
